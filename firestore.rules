rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isConfiguredAdmin() {
      return signedIn()
        && (
          request.auth.uid == 'CMfAk2XtYCNTafxbw7CaHtSumls1'
          || request.auth.uid == 'j5SOae8A7vYFPZXGlymLOoTuQS93'
          || request.auth.token.email == 'adminlocal@gmail.com'
          || request.auth.token.email == 'teeraphon.sud@gmail.com'
        );
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isConfiguredAdmin()
        || (signedIn() && currentUserDoc().data.role == 'admin');
    }

    function hasValidUserShape(data) {
      return data.keys().hasAll(['username', 'email', 'name', 'role'])
        && data.keys().hasOnly(['username', 'email', 'name', 'role', 'avatar', 'phone'])
        && data.username is string
        && data.email is string
        && data.name is string
        && data.role in ['admin', 'officer', 'general']
        && (!('avatar' in data) || data.avatar is string)
        && (!('phone' in data) || data.phone is string);
    }

    function allowSelfSetupAdmin() {
      // Self-setup mode: allow creating an admin profile from the app.
      // Set this to `false` after bootstrap if you want strict whitelist-only admin creation.
      return true;
    }

    function safeSelfCreate(userId) {
      return isSelf(userId)
        && hasValidUserShape(request.resource.data)
        && (
          request.resource.data.role != 'admin'
          || isConfiguredAdmin()
          || allowSelfSetupAdmin()
        );
    }

    function safeSelfUpdate(userId) {
      return isSelf(userId)
        && hasValidUserShape(request.resource.data)
        && request.resource.data.username == resource.data.username
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role;
    }

    match /users/{userId} {
      allow create: if safeSelfCreate(userId) || isAdmin();
      allow read: if isSelf(userId) || isAdmin();
      allow update: if safeSelfUpdate(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /docTypes/{id} {
      allow read, write: if signedIn();
    }

    match /documents/{id} {
      allow read, write: if signedIn();
    }
  }
}
